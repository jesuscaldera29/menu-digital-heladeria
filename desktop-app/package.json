{
  "name": "menu-digital-pro",
  "productName": "Menu Digital Pro",
  "version": "2.0.0",
  "description": "Sistema de Punto de Venta con Impresion Integrada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.heladeria.pos",
    "files": [
      "main.js",
      "preload.js",
      "escpos-builder.js",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "Jesus Caldera",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  }
}
