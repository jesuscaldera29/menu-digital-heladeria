{
  "name": "printbridge",
  "version": "1.0.0",
  "description": "PrintBridge - Servidor de impresión directa para impresoras térmicas POS por IP/LAN",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output PrintBridge.exe"
  },
  "pkg": {
    "assets": [
      "config.json"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jimp": "^0.16.13",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
